local function makeToggle(parent, text, y, default, callback)
    local state = default
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -28, 0, 38)
    btn.Position = UDim2.new(0, 14, 0, y)
    btn.BackgroundColor3 = Color3.fromRGB(32, 16, 20)
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -70, 1, 0)
    lbl.Position = UDim2.fromOffset(14, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(245, 220, 225)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 14
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = btn

    local track = Instance.new("Frame")
    track.Size = UDim2.fromOffset(42, 22)
    track.Position = UDim2.new(1, -54, 0.5, -11)
    track.BackgroundColor3 = state and Color3.fromRGB(220, 40, 60) or Color3.fromRGB(50, 30, 35)
    track.Parent = btn
    Instance.new("UICorner", track).CornerRadius = UDim.new(0, 11)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(18, 18)
    knob.Position = UDim2.fromOffset(state and 22 or 2, 2)
    knob.BackgroundColor3 = Color3.new(1,1,1)
    knob.Parent = track
    Instance.new("UICorner", knob).CornerRadius = UDim.new(0, 9)

    btn.MouseButton1Click:Connect(function()
        state = not state
        TweenService:Create(track, TweenInfo.new(0.15), {
            BackgroundColor3 = state and Color3.fromRGB(220, 40, 60) or Color3.fromRGB(50, 30, 35)
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = UDim2.fromOffset(state and 22 or 2, 2)
        }):Play()
        if callback then callback(state) end
    end)
end

local function makeSlider(card, name, y, minV, maxV, def, callback)
    local lab = Instance.new("TextLabel")
    lab.Size = UDim2.new(1, -30, 0, 22)
    lab.Position = UDim2.new(0, 16, 0, y)
    lab.BackgroundTransparency = 1
    lab.Text = name .. ": " .. def
    lab.TextColor3 = Color3.fromRGB(245, 210, 215)
    lab.Font = Enum.Font.Gotham
    lab.TextSize = 14
    lab.TextXAlignment = Enum.TextXAlignment.Left
    lab.Parent = card

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -32, 0, 10)
    bar.Position = UDim2.new(0, 16, 0, y + 30)
    bar.BackgroundColor3 = Color3.fromRGB(40, 20, 25)
    bar.BorderSizePixel = 0
    bar.Parent = card
    Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 5)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((def - minV) / (maxV - minV), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(220, 40, 60)
    fill.BorderSizePixel = 0
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 5)

    local dragging = false
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
    end)
    bar.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    RunService.RenderStepped:Connect(function()
        if dragging then
            local m = UserInputService:GetMouseLocation()
            local r = math.clamp((m.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            fill.Size = UDim2.new(r, 0, 1, 0)
            local v = math.floor(minV + r * (maxV - minV))
            lab.Text = name .. ": " .. v
            callback(v)
        end
    end)
end

