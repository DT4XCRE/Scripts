-- ==================== ROLE ====================
local function getRole(plr)
    local char = plr.Character
    if not char then return "Unknown" end
    -- Check Backpack and Character for weapons
    local hasWeapon = function(name)
        return (char:FindFirstChild(name) ~= nil) or (plr.Backpack and plr.Backpack:FindFirstChild(name) ~= nil)
    end
    
    if hasWeapon("Knife") then return "Murderer" end
    if hasWeapon("Gun") then return "Sheriff" end
    return "Innocent"
end

local roleColors = {
    Murderer = Color3.fromRGB(255, 60, 60),
    Sheriff  = Color3.fromRGB(60, 140, 255),
    Innocent = Color3.fromRGB(230, 230, 230),
    Unknown  = Color3.fromRGB(150, 150, 150),
}

-- ==================== HELPERS ====================
local function getChar() return player.Character end
local function getHRP() local c = getChar() return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum() local c = getChar() return c and c:FindFirstChildOfClass("Humanoid") end
local function isAlive(plr)
    local char = plr.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

-- Apply speed stats to current character
local function applyStats()
    local h = getHum()
    if h then
        h.WalkSpeed = Config.WalkSpeed
        h.JumpPower = Config.JumpPower
    end
end

-- ==================== ESP ====================
local function clearESP()
    for _, obj in pairs(espObjects) do
        pcall(function() if obj and obj.Parent then obj:Destroy() end end)
    end
    table.clear(espObjects)
end

local function createESP(plr)
    if plr == player then return end
    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    local role = getRole(plr)
    local color = roleColors[role] or roleColors.Unknown

    local hl = Instance.new("Highlight")
    hl.Adornee = char
    hl.FillColor = color
    hl.OutlineColor = color
    hl.FillTransparency = 0.65
    hl.OutlineTransparency = 0
    hl.Parent = char
    table.insert(espObjects, hl)

    local bb = Instance.new("BillboardGui")
    bb.Adornee = head or hrp
    bb.Size = UDim2.fromOffset(150, 45)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.Parent = char
    table.insert(espObjects, bb)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.TextColor3 = color
    label.TextStrokeTransparency = 0.35
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.Parent = bb

    local myHRP = getHRP()
    local dist = myHRP and math.floor((hrp.Position - myHRP.Position).Magnitude) or 0
    local text = plr.Name
    if Config.ShowRole then text = text .. "\n[" .. role .. "]" end
    if Config.ShowDistance then text = text .. "\n" .. dist .. "m" end
    label.Text = text
end

local function updateESP()
    clearESP()
    if not Config.ESP then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        createESP(plr)
    end
end

-- ==================== AUTO FEATURES ====================

-- MURDERER LOGIC
-- Only targets Innocents and Sheriffs. Ignores other Murderers.
local function autoMurder()
    if not Config.AutoMurder or getRole(player) ~= "Murderer" then return end
    if tick() - lastStab < 0.35 then return end

    local myHRP = getHRP()
    if not myHRP then return end

    local closest, closestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and isAlive(plr) then
            local targetRole = getRole(plr)
            -- SKIP OTHER MURDERERS
            if targetRole == "Murderer" then continue end
            
            local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (hrp.Position - myHRP.Position).Magnitude
                if dist < closestDist and dist < 130 then
                    closestDist = dist
                    closest = hrp
                end
            end
        end
    end

    if closest then
        local behind = closest.CFrame * CFrame.new(0, 0, 3.1)
        myHRP.CFrame = CFrame.new(behind.Position, closest.Position)
        task.wait(0.04)
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            task.wait(0.07)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end)
        lastStab = tick()
    end
end

-- COIN LOGIC
local function autoCoin()
    if not Config.AutoCoin then return end
    if tick() - lastCoin < 0.4 then return end

    local myHRP = getHRP()
    if not myHRP then return end

    local closestCoin, closestDist = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name:lower():find("coin") or obj.Name:lower():find("money")) then
            local dist = (obj.Position - myHRP.Position).Magnitude
            if dist < closestDist and dist < 220 then
                closestDist = dist
                closestCoin = obj
            end
        end
    end

    if closestCoin then
        myHRP.CFrame = CFrame.new(closestCoin.Position + Vector3.new(0, 3, 0))
        lastCoin = tick()
    end
end

-- SHERIFF LOGIC
-- 300ms cooldown, 10 stud range check
local function autoSheriffKill()
    if not Config.AutoSheriffKill or getRole(player) ~= "Sheriff" then return end
    if tick() - lastSheriffShot < Config.SheriffCooldown then return end

    local myHRP = getHRP()
    if not myHRP then return end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and isAlive(plr) and getRole(plr) == "Murderer" then
            local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            local head = plr.Character and plr.Character:FindFirstChild("Head")
            
            if hrp then
                local dist = (hrp.Position - myHRP.Position).Magnitude
                
                -- CHECK RANGE (10 studs)
                if dist <= Config.SheriffRange then
                    -- Aim behind the murderer
                    myHRP.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 0, 4), hrp.Position)
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, (head or hrp).Position)
                    task.wait(0.04)
                    pcall(function()
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                        task.wait(0.06)
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                    end)
                    lastSheriffShot = tick()
                    break
                end
            end
        end
    end
end

