local capacityLabel = nil
local function getCapacity()
    if not capacityLabel or not capacityLabel.Parent then
        capacityLabel = nil
        for _, gui in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
            if gui:IsA("TextLabel") and string.find(gui.Text, "Capacity:") then
                capacityLabel = gui
                break
            end
        end
    end
    if capacityLabel then
        local current, max = string.match(capacityLabel.Text, "(%d+)/(%d+)")
        if current and max then
            return tonumber(current), tonumber(max)
        end
    end
    return 0, 36
end

local function getNilFolderOrParts(layerName)
    local results = {}
    if getnilinstances then
        pcall(function()
            for _, inst in ipairs(getnilinstances()) do
                if inst.Name == layerName or (inst.Parent and inst.Parent.Name == layerName) then
                    if inst:IsA("BasePart") then
                        table.insert(results, inst)
                    elseif inst:IsA("Folder") or inst:IsA("Model") then
                        for _, child in ipairs(inst:GetChildren()) do
                            if child:IsA("BasePart") then
                                table.insert(results, child)
                            end
                        end
                    end
                end
            end
        end)
    end
    return results
end

local function goToQuarry()
    local quarry = workspace:FindFirstChild("Quarry")
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp and quarry then
        local targetCFrame
        if quarry:IsA("Model") and quarry.PrimaryPart then
            targetCFrame = quarry:GetPrimaryPartCFrame()
        elseif quarry:IsA("BasePart") then
            targetCFrame = quarry.CFrame
        else
            local anyPart = quarry:FindFirstChildWhichIsA("BasePart", true)
            if anyPart then
                targetCFrame = anyPart.CFrame
            end
        end
        if targetCFrame then
            hrp.CFrame = targetCFrame * CFrame.new(0, 3, 0)
        end
    end
end

local function getCurrentLayerUnfilledParts()
    local pyramidCover = workspace:FindFirstChild("ClientPyramidCover")
    
    -- Method 1: Highest non-empty Layer folder
    if pyramidCover then
        for layerNum = 99, 1, -1 do
            local layerName = "Layer" .. tostring(layerNum)
            local folder = pyramidCover:FindFirstChild(layerName)
            if folder then
                local parts = {}
                for _, child in ipairs(folder:GetChildren()) do
                    if child:IsA("BasePart") then
                        table.insert(parts, child)
                    end
                end
                if #parts > 0 then
                    table.sort(parts, function(a, b) return a.Name < b.Name end)
                    return parts, layerNum
                end
            end
        end
    end

    if getnilinstances then
        for layerNum = 99, 1, -1 do
            local layerName = "Layer" .. tostring(layerNum)
            local parts = getNilFolderOrParts(layerName)
            if #parts > 0 then
                table.sort(parts, function(a, b) return a.Name < b.Name end)
                return parts, layerNum
            end
        end
    end

    if pyramidCover then
        local parts = {}
        for _, child in ipairs(pyramidCover:GetDescendants()) do
            if child:IsA("BasePart") then
                table.insert(parts, child)
            end
        end
        if #parts > 0 then
            table.sort(parts, function(a, b) return a.Name < b.Name end)
            return parts, 0
        end
    end

    return {}, 0
end

-- Cached parts
local cachedParts = {}
local cachedLayer = 0
local lastPartsRefresh = 0

local function getCachedUnfilledParts()
    if tick() - lastPartsRefresh > PARTS_REFRESH_INTERVAL or #cachedParts == 0 then
        cachedParts, cachedLayer = getCurrentLayerUnfilledParts()
        lastPartsRefresh = tick()
    end
    return cachedParts, cachedLayer
end

local function runPyramidBuild()
    task.spawn(function()
        while BuildEnabled and ScriptRunning do
            local current, max = getCapacity()

            if current == 0 then
                StatusLabel.Text = "Status: Collecting at Quarry..."
                goToQuarry()

                while BuildEnabled and ScriptRunning do
                    current, max = getCapacity()
                    StatusLabel.Text = "Status: Collecting... (" .. current .. "/" .. max .. ")"
                    if current >= max then break end
                    task.wait(0.3)
                end
            else
                local parts, layerNum = getCachedUnfilledParts()

                if #parts > 0 then
                    local layerText = layerNum > 0 and ("Layer " .. layerNum) or "Current"
                    StatusLabel.Text = "Status: Building " .. layerText .. "..."

                    for i, part in ipairs(parts) do
                        if not BuildEnabled or not ScriptRunning then break end

                        local cur = getCapacity()
                        if cur == 0 then
                            StatusLabel.Text = "Status: Out of blocks"
                            break
                        end

                        local char = LocalPlayer.Character
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")
                        if hrp and part and part.Parent then
                            hrp.CFrame = part.CFrame * CFrame.new(0, 2.8, 0)
                            task.wait(TELEPORT_DELAY)
                        end

                        if i % 10 == 0 then
                            StatusLabel.Text = "Status: " .. layerText .. " (" .. i .. "/" .. #parts .. ")"
                        end
                    end
                else
                    StatusLabel.Text = "Status: No spots found - waiting..."
                    task.wait(1.5)
                end
            end

            task.wait(0.2)
        end

        if ScriptRunning then
            StatusLabel.Text = "Status: Stopped"
        end
    end)
end

