local function makeSlider(card, name, y, minV, maxV, def, color, callback)
    local lab = Instance.new("TextLabel")
    lab.Size = UDim2.new(1, -30, 0, 22)
    lab.Position = UDim2.new(0, 18, 0, y)
    lab.BackgroundTransparency = 1
    lab.Text = name .. ": " .. def
    lab.TextColor3 = Color3.fromRGB(200, 220, 255)
    lab.Font = Enum.Font.Gotham
    lab.TextSize = 15
    lab.TextXAlignment = Enum.TextXAlignment.Left
    lab.Parent = card

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -36, 0, 10)
    bar.Position = UDim2.new(0, 18, 0, y + 32)
    bar.BackgroundColor3 = Color3.fromRGB(28, 30, 42)
    bar.BorderSizePixel = 0
    bar.Parent = card
    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(0, 5)
    bc.Parent = bar

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((def - minV) / (maxV - minV), 0, 1, 0)
    fill.BackgroundColor3 = color
    fill.BorderSizePixel = 0
    fill.Parent = bar
    local fc = Instance.new("UICorner")
    fc.CornerRadius = UDim.new(0, 5)
    fc.Parent = fill

    local dragging = false
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
        end
    end)
    bar.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    RunService.RenderStepped:Connect(function()
        if dragging then
            local m = UserInputService:GetMouseLocation()
            local r = math.clamp((m.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            fill.Size = UDim2.new(r, 0, 1, 0)
            local v = math.floor(minV + r * (maxV - minV))
            lab.Text = name .. ": " .. v
            callback(v)
        end
    end)
end

