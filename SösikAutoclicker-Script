-- Settings
local settings = {
    Enabled = false,
    Interval = 0,
    Milliseconds = 100,
    MouseButton = "Left",
    UseCurrentLocation = true,
    PickedX = 0,
    PickedY = 0,
    WaitingForPick = false,
    Hotkey = Enum.KeyCode.Q
}

-- Red Cursor
local RedCursor = Instance.new("Frame")
RedCursor.Size = UDim2.new(0, 12, 0, 12)
RedCursor.BackgroundColor3 = Color3.fromRGB(255, 30, 30)
RedCursor.BorderSizePixel = 0
RedCursor.AnchorPoint = Vector2.new(0.5, 0.5)
RedCursor.Visible = false
RedCursor.ZIndex = 100
RedCursor.Parent = player:WaitForChild("PlayerGui")

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(1, 0)
UICorner.Parent = RedCursor

local function updateRedCursor(x, y)
    RedCursor.Position = UDim2.new(0, x, 0, y)
    RedCursor.Visible = true
end

local function getWaitTime()
    return settings.Interval + (settings.Milliseconds / 1000)
end

local function doClick()
    local x, y

    if settings.UseCurrentLocation then
        local pos = UserInputService:GetMouseLocation()
        x = pos.X
        y = pos.Y
    else
        x = settings.PickedX
        y = settings.PickedY
    end

    -- Show red cursor
    updateRedCursor(x, y)

    if settings.MouseButton == "Left" then
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    else
        VirtualInputManager:SendMouseButtonEvent(x, y, 1, true, game, 1)
        VirtualInputManager:SendMouseButtonEvent(x, y, 1, false, game, 1)
    end
end

-- Click Loop
task.spawn(function()
    while true do
        if settings.Enabled then
            doClick()
            task.wait(getWaitTime())
        else
            RedCursor.Visible = false
            task.wait(0.05)
        end
    end
end)

