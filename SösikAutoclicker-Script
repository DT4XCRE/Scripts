-- Logic
local function updateInterval()
    settings.Interval = math.clamp(tonumber(SecBox.Text) or 0, 0, 59)
    settings.Milliseconds = math.clamp(tonumber(MsBox.Text) or 0, 0, 999)
end

SecBox.FocusLost:Connect(updateInterval)
MsBox.FocusLost:Connect(updateInterval)

