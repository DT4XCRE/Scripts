    settings.WaitingForPick = true
    PickLocBtn.Text = "Click anywhere..."
    PickLocBtn.BackgroundColor3 = Color3.fromRGB(180, 80, 0)
end)

UserInputService.InputBegan:Connect(function(input, processed)
    if settings.WaitingForPick and input.UserInputType == Enum.UserInputType.MouseButton1 then
        local pos = UserInputService:GetMouseLocation()
        settings.PickedX = pos.X
        settings.PickedY = pos.Y
        settings.WaitingForPick = false
        CoordLabel.Text = "X: " .. math.floor(pos.X) .. "   Y: " .. math.floor(pos.Y)
        PickLocBtn.Text = "PICK LOCATION"
        PickLocBtn.BackgroundColor3 = Color3.fromRGB(60, 40, 100)
    end

    if not processed and input.KeyCode == settings.Hotkey then
        settings.Enabled = not settings.Enabled
        if settings.Enabled then
            StartBtn.Text = "STOP"
            StartBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
            StatusLabel.Text = "Status: Running"
            StatusLabel.TextColor3 = Color3.fromRGB(0, 220, 100)
        else
            StartBtn.Text = "START"
            StartBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
            StatusLabel.Text = "Status: Stopped"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            RedCursor.Visible = false
        end
    end
end)

StartBtn.MouseButton1Click:Connect(function()
    settings.Enabled = not settings.Enabled
    if settings.Enabled then
        StartBtn.Text = "STOP"
        StartBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
